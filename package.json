{
  "name": "demo-reel",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "vite build --config apps/web/vite.config.ts",
    "check": "tsx scripts/check.ts",
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:worker": "tsx apps/worker/src/main.ts",
    "dev:demo": "tsx apps/demo/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "preview:web": "vite preview --config apps/web/vite.config.ts --port 5173 --host 127.0.0.1",
    "poc": "tsx scripts/poc.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "start:worker": "tsx apps/worker/src/main.ts",
    "start:api": "tsx apps/api/src/main.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.1128.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.3",
    "fastify": "5.12.3",
    "ipaddr.js": "^2.5.0",
    "pg": "8.23.0",
    "pg-boss": "12.30.0",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
