# Service defaults. Copy to .env for local use; set variables directly on each host for deployment.
# All credentials are intentionally blank.
NODE_ENV=development
POC_MODE=false
DATABASE_URL=
ENCRYPTION_KEY=
WEB_ORIGIN=http://127.0.0.1:5173
HOST=127.0.0.1
API_PORT=4000
WORKER_HEALTH_PORT=4002
DATA_DIR=output

# Worker only
OPENAI_API_KEY=
OPENAI_PLANNER_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Private S3-compatible bucket; set on API and worker.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

DAILY_QUOTA=3
DAILY_PLAN_QUOTA=10
GLOBAL_DAILY_JOBS=50
# Test fixtures only: opt in explicitly with POC_MODE=true; never deploy this mode.
DEMO_ORIGIN=http://127.0.0.1:4001
DEMO_PORT=4001
